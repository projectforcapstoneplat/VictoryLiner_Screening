# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — restricts the HR Portal's "Sign in with Google" button to one
# Google Workspace domain (e.g. victoryliner.com), so the account picker
# only offers company accounts. Leave unset to allow any Google account
# (still gated by the HR-role check after sign-in either way).
VITE_HR_GOOGLE_DOMAIN=
